ervers.", "answer": [{"claim_type": "price_statement", "text": "The price of cooking gas has risen to N15,260 per 12.5kg refill in Lagos", "passage": "The price of cooking gas has risen to N15,260 per 12.5kg refill in Lagos", "item_code": "lpg_12_5kg", "policy_series": null, "stated_value": 15260.0, "stated_unit": null, "direction": "up", "occurred_from": "2024-10-01", "occurred_to": "2024-10-31", "time_precision": "month", "place_candidates": ["Lagos"]}]}, {"key": "n2", "source": "vanguard", "title": "Prices in the news", "published": "2024-11-14T09:00:00Z", "withdrawn": false, "copy_of": "n1", "append": " (Agency)", "answer": []}, {"key": "n3", "source": "channels", "title": "Prices in the news", "published": "2024-11-14T09:00:00Z", "withdrawn": false, "text": "The price of cooking gas has risen to N15,300 per 12.5kg refill in Lagos. Dealers added that some stalls opened later than usual and nobody expected a quick change. Commercial drivers said in a statement that the picture differed from street to street as the month drew to a close. Distributors added that weekly sales were uneven in a mood described as cautious. Wholesalers noted that some stalls opened later than usual while talks continued behind closed doors. Marketers said on Tuesday that a committee would meet later in the month and nobody expected a quick change. Consumer advocates said on Tuesday that transport fares were being reviewed although the detail was still unclear. Analysts argued that a committee would meet later in the month as it had done the year before.", "answer": [{"claim_type": "price_statement", "text": "The price of cooking gas has risen to N15,300 per 12.5kg refill in Lagos", "passage": "The price of cooking gas has risen to N15,300 per 12.5kg refill in Lagos", "item_code": "lpg_12_5kg", "policy_series": null, "stated_value": 15300.0, "stated_unit": null, "direction": "up", "occurred_from": "2024-10-01", "occurred_to": "2024-10-31", "time_precision": "month", "place_candidates": [