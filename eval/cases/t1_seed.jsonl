e in Lagos", "passage": "The pump price of petrol has risen to N1,081 per litre in Lagos", "item_code": "pms_litre", "policy_series": null, "stated_value": 1081.0, "stated_unit": null, "direction": "up", "occurred_from": "2024-10-01", "occurred_to": "2024-10-31", "time_precision": "month", "place_candidates": ["Lagos"]}]}], "measurements": [{"item": "pms_litre", "place": "NG-LA", "period": "2024-09", "value": 1000.88, "vintage": "2024-10-12", "document": "nbs-2024-09-2024-10-12"}, {"item": "pms_litre", "place": "NG-LA", "period": "2024-10", "value": 1080.95, "vintage": "2024-11-12", "document": "nbs-2024-10-2024-11-12"}], "publication_suspended": false, "expected": {"decision": "publish", "evidence_state": "corroborated", "severity": "low", "place": "NG-LA", "date": "2024-10-01", "numbers": {"Current price": 1080.95, "Previous month": 1000.88, "Month-on-month change": 8.0, "Independent reports": 1}, "rules": [], "claims": [{"doc": "n1", "passage": "The pump price of petrol has risen to N1,081 per litre in Lagos", "valid": true, "reason": null, "place": "NG-LA"}]}, "explanation": {"expect": "accepted", "answers": ["Petrol in Lagos State rose 8.0% in October 2024, and one independent report points the same way."]}}
