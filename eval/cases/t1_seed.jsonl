e": "The price of local rice has risen to N1,284 per kg in Nigeria", "item_code": "rice_local_1kg", "policy_series": null, "stated_value": 1284.0, "stated_unit": null, "direction": "up", "occurred_from": "2024-10-01", "occurred_to": "2024-10-31", "time_precision": "month", "place_candidates": ["Nigeria"]}]}], "measurements": [{"item": "rice_local_1kg", "place": "NG", "period": "2024-09", "value": 1200.0, "vintage": "2024-10-12", "document": "nbs-2024-09-2024-10-12"}, {"item": "rice_local_1kg", "place": "NG", "period": "2024-10", "value": 1284.0, "vintage": "2024-11-12", "document": "nbs-2024-10-2024-11-12"}], "publication_suspended": false, "expected": {"decision": "publish", "evidence_state": "corroborated", "severity": "low", "place": "NG", "date": "2024-10-01", "numbers": {"Current price": 1284.0, "Previous month": 1200.0, "Month-on-month change": 7.0, "Independent reports": 1}, "rules": [], "claims": [{"doc": "n1", "passage": "The price of local rice has risen to N1,284 per kg in Nigeria", "valid": true, "reason": null, "place": "NG"}]}}
