{"id": "t1-diesel-two-outlets", "template": "T1", "split": "test", "origin_group": "t1-ago", "tags": ["corroboration"], "now": "2024-11-25T12:00:00Z", "situation": {"item": "ago_litre", "place": "NG-KN"}, "documents": [{"key": "nbs-2024-09-2024-10-12", "source": "nbs", "title": "Automotive Gas Oil (Diesel) Price Watch September 2024", "published": "2024-10-12T09:00:00Z", "text": "Synthetic stand-in for the Automotive Gas Oil (Diesel) Price Watch for September 2024, released 2024-10-12. Average retail prices by state and nationally. Written for the evaluation set; not an NBS publication."}, {"key": "nbs-2024-10-2024-11-12", "source": "nbs", "title": "Automotive Gas Oil (Diesel) Price Watch October 2024", "published": "2024-11-12T09:00:00Z", "text": "Synthetic stand-in for the Automotive Gas Oil (Diesel) Price Watch for October 2024, released 2024-11-12. Average retail prices by state and nationally. Written for the evaluation set; not an NBS publication."}, {"key": "n1", "source": "punch", "title": "Prices in the news", "published": "2024-11-14T09:00:00Z", "withdrawn": false, "text": "The price of diesel has risen to N1,166 per litre in Kano. Transport union leaders reported that transport fares were being reviewed while talks continued behind closed doors. Marketers noted that transport fares were being reviewed according to people present at the meeting. Distributors noted that some stalls opened later than usual and nobody expected a quick change. Station managers noted that transport fares were being reviewed although the detail was still unclear. Transport union leaders explained that some stalls opened later than usual which surprised few observers. Transport union leaders noted that weekly sales were uneven according to people present at the meeting. Consumer advocates said on Tuesday that buyers compared offers at several outlets although the detail was still unclear.", "answer": [{"claim_type": "price_statement", "text": "The price of diesel has risen to N1,166 per litre in Kano", "passage": "The price of diesel has risen to N1,166 per litre in Kano", "item_code": "ago_litre", "policy_series": null, "stated_value": 1166.0, "stated_unit": null, "direction": "up", "occurred_from": "2024-10-01", "occurred_to": "2024-10-31", "time_precision": "month", "place_candidates": ["Kano"]}]}, {"key": "n2", "source": "dailytrust", "title": "Prices in the news", "published": "2024-11-14T09:00:00Z", "withdrawn": false, "text": "The price of diesel has risen to N1,170 per litre in Kano. Commercial drivers warned that the picture differed from street to street as the month drew to a close. Transport union leaders insisted that buyers compared offers at several outlets in a mood described as cautious. Transport union leaders argued that queues formed in the early morning after a quiet start to the week. Shop owners said on Tuesday that weekly sales were uneven and nobody expected a quick change. Transport union leaders argued that queues formed in the early morning as it had done the year before. Analysts said in a statement that transport fares were being reviewed as it had done the year before. Officials complained that a committee would meet later in the month as the month drew to a close.", "answer": [{"claim_type": "price_statement", "text": "The price of diesel has risen to N1,170 per litre in Kano", "passage": "The price of diesel has risen to N1,170 per litre in Kano", "item_code": "ago_litre", "policy_series": null, "stated_value": 1170.0, "stated_unit": null, "direction": "up", "occurred_from": "2024-10-01", "occurred_to": "2024-10-31", "time_precision": "month", "place_candidates": ["Kano"]}]}], "measurements": [{"item": "ago_litre", "place": "NG-KN", "period": "2024-09", "value": 1100.0, "vintage": "2024-10-12", "document": "nbs-2024-09-2024-10-12"}, {"item": "ago_litre", "place": "NG-KN", "period": "2024-10", "value": 1166.0, "vintage": "2024-11-12", "document": "nbs-2024-10-2024-11-12"}], "publication_suspended": false, "ex