 fares were being reviewed as it had done the year before. Shop owners said in a statement that supply to smaller outlets arrived late in a mood described as cautious. Wholesalers reported that buyers compared offers at several outlets in a mood described as cautious. Dealers told reporters that transport fares were being reviewed with attention on the coming weeks. Marketers argued that a committee would meet later in the month with attention on the coming weeks. Bus operators noted that supply to smaller outlets arrived late which surprised few observers. Station managers noted that supply to smaller outlets arrived late according to people present at the meeting.", "answer": [{"claim_type": "policy_statement", "text": "NERC approved a Band A tariff of N240.00/kWh for Ikeja Electric.", "passage": "a Band A tariff of N240.00/kWh for customers of Ikeja Electric. The order takes effect on 1 September 2025.", "item_code": null, "policy_series": "electricity_tariff_band_a:ikeja-electric", "stated_value": 240.0, "stated_unit": "NGN/kWh", "direction": "unknown", "occurred_from": "2025-09-01", "occurred_to": null, "time_precision": "month", "place_candidates": []}]}], "publication_suspended": true, "expected": {"decision": "withhold", "evidence_state": "reported", "severity": "medium", "place": "NG-LA", "date": "2025-09-01", "numbers": {"Current rate": 240.0, "Previous rate": 209.5, "Increase in rate": 30.5, "Change in rate": 14.6}, "rules": ["R1"], "claims": [{"doc": "d1", "passage": "a Band A tariff of N209.50/kWh for customers of Ikeja Electric. The order takes effect on 1 March 2025.", "valid": true, "reason": null}, {"doc": "d2", "passage": "a Band A tariff of N240.00/kWh for customers of Ikeja Electric. The order takes effect on 1 September 2025.", "valid": true, "reason": null}]}}
