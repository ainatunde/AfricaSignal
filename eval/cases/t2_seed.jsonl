{"id": "t2-boundary-four-x", "template": "T2", "split": "dev", "origin_group": "t2-ikeja", "tags": ["boundary", "severity"], "now": "2025-10-20T12:00:00Z", "situation": {"series": "electricity_tariff_band_a:ikeja-electric", "place": "NG-LA"}, "documents": [{"key": "d1", "source": "nerc", "title": "Order of 2025-02-15", "published": "2025-02-15T09:00:00Z", "text": "The Commission approves a Band A tariff of N200.00/kWh for customers of Ikeja Electric. The order takes effect on 1 March 2025. Station managers insisted that supply to smaller outlets arrived late and nobody expected a quick change. Consumer advocates warned that customers had started to change how often they buy which surprised few observers. Distributors reported that some stalls opened later than usual and nobody expected a quick change. Transport union leaders warned that the state government had not commented according to people present at the meeting. Wholesalers noted that customers had started to change how often they buy and nobody expected a quick change. Shop owners complained that older stock was being sold first while talks continued behind closed doors. Consumer advocates added that weekly sales were uneven as it had done the year before.", "answer": [{"claim_type": "policy_statement", "text": "NERC approved a Band A tariff of N200.00/kWh for Ikeja Electric.", "passage": "a Band A tariff of N200.00/kWh for customers of Ikeja Electric. The order takes effect on 1 March 2025.", "item_code": null, "policy_series": "electricity_tariff_band_a:ikeja-electric", "stated_value": 200.0, "stated_unit": "NGN/kWh", "direction": "unknown", "occurred_from": "2025-03-01", "occurred_to": null, "time_precision": "month", "place_candidates": []}]}, {"key": "d2", "source": "nerc", "title": "Order of 2025-08-20", "published": "2025-08-20T09:00:00Z", "text": "The Commission approves a Band A tariff of N240.00/kWh for customers of Ikeja Electric. The order takes effect on 1 September 2025. Officials warned that tr